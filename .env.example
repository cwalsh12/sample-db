# Copy this file to .env and replace every change_me value.
# Format: KEY=value (no spaces around =, no quotes). Never commit .env.

# Postgres superuser (admin setup only; the pipeline and Superset never use it)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sampledb

# Where Python connects to Postgres. Use 127.0.0.1, not localhost: on Windows,
# localhost tries IPv6 first and hangs for ~2 minutes before falling back.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Login roles created by sql/setup/02_roles.sql
ETL_PASSWORD=change_me
SUPERSET_READER_PASSWORD=change_me

# Google Sheet linked to the form. The ID is the part of the sheet's URL between /d/ and /edit.
# The key file is downloaded from Google Cloud; keep it in secrets/ (ignored by git).
GOOGLE_SHEET_ID=change_me
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
